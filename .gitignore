# ==============================================================================
# NAGRIKSETU SKILL DEVELOPMENT MICROSERVICE - .GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (CRITICAL SECURITY EXCLUSIONS)
# ------------------------------------------------------------------------------
# Never commit actual environment files containing live credentials or API keys
.env
.env.local
.env.*.local
*.local.env

# Preserve example configuration templates for deployment
!.env.example
!backend/.env.example

# Private credentials, credential generators, and secret exports
*.pem
*.key
*.cert
*.pfx
*credentials*.csv
*credentials*.docx
*passwords*.docx
*login details*.txt
generate_creds.py
set_10_permanent_credentials.py
rotate_passwords_docker.py


# ------------------------------------------------------------------------------
# 2. Node & JavaScript Dependencies / Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Build Output (generated by npm run build)
dist/
build/
.output/
frontend/dist/
frontend/build/
*.tsbuildinfo

# Backup files
*.bak
*.bak_*


# Vite Cache
.vite/
frontend/.vite/

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments, Bytecode & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 4. OS & IDE Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE / Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. Database Live Dumps & Temporary Files
# ------------------------------------------------------------------------------
*.sqlite3
*.db-journal
*.log
logs/
*.tmp
*.bak
